{
  "policy_id": "local-agent-gateway-v1",
  "allowed_hosts": ["127.0.0.1:8080", "localhost:8080", "[::1]:8080"],
  "allowed_origins": ["https://console.example.test"],
  "require_origin": true,
  "max_http_body_bytes": 10485760,
  "max_websocket_message_bytes": 16777216,
  "require_bound_approval_for_side_effects": true,
  "max_approval_ttl_seconds": 300,
  "clock_skew_seconds": 30
}
